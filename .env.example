JENEFAR_NAME=Jenefar
JENEFAR_WAKE_PHRASES=Hi Jenefar,Hello Jenefar

# Required for model-backed responses
OPENAI_API_KEY=
OPENAI_MODEL=

# Multi-provider online LLM failover. Providers are tried left-to-right.
JENEFAR_PROVIDER_ORDER=openai,openrouter,gemini,groq
JENEFAR_PROVIDER_COOLDOWN_SECONDS=60

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Groq (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=hi
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# Cerebras (OpenAI-compatible endpoint)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Voice models
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Continuous voice audio failover. OpenAI is tried first, then Groq.
# Set to "groq,openai" to prefer Groq when both keys are present.
JENEFAR_VOICE_PROVIDER_ORDER=groq,openai
# Quota exhaustion is kept out of the voice rotation for 1 hour by default.
JENEFAR_VOICE_QUOTA_COOLDOWN_SECONDS=3600
# Set this to true only when your Groq organization has not accepted
# the Orpheus TTS model terms. STT will continue to use Groq normally.
JENEFAR_DISABLE_GROQ_TTS=false

JENEFAR_LOG_LEVEL=INFO
JENEFAR_REQUIRE_CONFIRMATION=false
JENEFAR_AUTHORIZED_TARGETS=

# Continuous voice / legacy phrase-listener tuning
JENEFAR_VOICE_SAMPLE_RATE=24000
JENEFAR_VOICE_BLOCK_MS=100
JENEFAR_VOICE_START_THRESHOLD=0.015
JENEFAR_VOICE_STOP_THRESHOLD=0.010
JENEFAR_VOICE_SILENCE_MS=850
JENEFAR_VOICE_MAX_UTTERANCE_SECONDS=12


# Local wake word (optional): path to a custom openWakeWord model
JENEFAR_WAKEWORD_MODEL_PATH=
JENEFAR_WAKEWORD_THRESHOLD=0.55

# VRM avatar: optional licensed local model served by the avatar server.
# When empty, the documented sample is provisioned automatically.
JENEFAR_AVATAR_VRM_PATH=
JENEFAR_PREMIUM_AVATAR=1
JENEFAR_BLENDER_BIN=
JENEFAR_BLENDER_TIMEOUT=180

# Browser Realtime voice
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=coral

# Natural browser TTS for normal Jenefar responses.
# Audio is generated by the server and played in the browser; no Python speaker playback is used.
JENEFAR_BROWSER_TTS_MODEL=gpt-4o-mini-tts
JENEFAR_BROWSER_TTS_VOICE=coral
JENEFAR_BROWSER_TTS_SPEED=0.98
JENEFAR_BROWSER_TTS_INSTRUCTIONS=Speak as a warm, natural, emotionally expressive adult female voice. Use a relaxed Indian conversational style for Roman Hinglish. Sound like a real person, not a narrator or robot. Use gentle pauses and natural emphasis.

# Robotics (optional)
JENEFAR_ROBOT_SERIAL_PORT=
JENEFAR_ROBOT_BAUDRATE=115200
JENEFAR_MQTT_HOST=
JENEFAR_MQTT_PORT=1883
JENEFAR_MQTT_COMMAND_TOPIC=jenefar/robot/command
JENEFAR_MQTT_TELEMETRY_TOPIC=jenefar/robot/telemetry

# Offline/local LLM fallback (OpenAI-compatible local server)
JENEFAR_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
JENEFAR_LOCAL_LLM_MODEL=

# Dedicated Kali security specialist model (optional; falls back to OPENAI_MODEL/local model)
JENEFAR_KALI_MODEL=

# Authorized local workspace roots (pathsep-separated; current project + /home/jenefar/Document/Tools are built in)
JENEFAR_WORKSPACE_ROOTS=


# Phase 1 model routing. Unset profiles fall back to OPENAI_MODEL online and JENEFAR_LOCAL_LLM_MODEL offline.
JENEFAR_MODEL_FAST=
JENEFAR_MODEL_REASONING=
JENEFAR_MODEL_CODING=
JENEFAR_MODEL_SECURITY=
JENEFAR_MODEL_RESEARCH=
JENEFAR_MODEL_ROBOTICS=
JENEFAR_MODEL_AUTOMATION=

# Optional per-role local model overrides.
JENEFAR_LOCAL_LLM_MODEL_FAST=
JENEFAR_LOCAL_LLM_MODEL_CODING=
JENEFAR_LOCAL_LLM_MODEL_SECURITY=
JENEFAR_LOCAL_LLM_MODEL_RESEARCH=
JENEFAR_LOCAL_LLM_MODEL_ROBOTICS=
JENEFAR_LOCAL_LLM_MODEL_AUTOMATION=
JENEFAR_LOCAL_LLM_MODEL_VISION=

# Phase 2 semantic GUI / vision
JENEFAR_MODEL_VISION=
JENEFAR_VISION_MODEL=
JENEFAR_VISION_CONFIDENCE=0.65
JENEFAR_VISION_MAX_DIMENSION=1600
JENEFAR_LOCAL_VISION_MODEL=qwen3-vl:4b
JENEFAR_LOCAL_VISION_BASE_URL=http://127.0.0.1:11434
JENEFAR_VISION_LOCAL_FIRST=true
JENEFAR_VISION_ALLOW_ONLINE=false

# Phase 3 declarative skill manifests. Multiple roots use the OS path separator.
JENEFAR_SKILL_ROOTS=

# Safe desktop validation. Use "headless" on servers/CI without a display.
# Native mode uses pyautogui and requires a real desktop session.
JENEFAR_DESKTOP_BACKEND=native

# Phase 4 persistent memory + scheduler data remain in the local data/ directory.
# Layered memory uses SQLite/FTS5 and optional sentence-transformers embeddings.
# Scheduler supports once, interval, daily and explicit event-watch triggers.

# Optional legacy/native Python TTS. Browser runtime does not use native TTS
# unless you explicitly enable it for a legacy CLI voice mode.
JENEFAR_ENABLE_NATIVE_TTS=0

# Optional local offline TTS. When piper is installed and this points to a
# licensed Piper ONNX voice model, it becomes the final TTS fallback.
JENEFAR_LOCAL_TTS_MODEL=

# Legacy voice path: calibrated phrase capture + Google STT (fallback to VAD/online STT).
JENEFAR_LEGACY_AMBIENT_SECONDS=0.7
JENEFAR_LEGACY_LISTEN_TIMEOUT=5
JENEFAR_LEGACY_PHRASE_LIMIT=10
JENEFAR_LEGACY_PAUSE_THRESHOLD=0.8
JENEFAR_LEGACY_STT_LANGUAGE=hi-IN
JENEFAR_EDGE_TTS_VOICE=en-IN-NeerjaNeural
JENEFAR_ESPEAK_RATE=165

# Primary one-command voice input: browser microphone (Chrome/Chromium Web Speech API).
# Browser playback prefers generated server audio and falls back to Edge TTS, then Web SpeechSynthesis.
JENEFAR_BROWSER_VOICE=1
