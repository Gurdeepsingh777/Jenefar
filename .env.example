JENEFAR_NAME=Jenefar
JENEFAR_WAKE_PHRASES=Hi Jenefar,Hello Jenefar

# Required for model-backed responses
OPENAI_API_KEY=
OPENAI_MODEL=

# Multi-provider LLM failover. Providers are tried left-to-right.
# Default: Groq -> Gemini -> OpenRouter -> APInex -> UnoRouter -> APMix -> NVIDIA -> Kilo -> Qwen -> optional OpenAI.
# If all online providers fail/exhaust quota, Jenefar automatically tries local Ollama/Qwen.
# Free-tier providers still have rate/request limits; daily-cap errors receive a long cooldown.
# Existing .env files using the old sample order are automatically migrated; custom orders are respected.
JENEFAR_PROVIDER_ORDER=groq,gemini,openrouter,apinex,unorouter,apmix,nvidia,kilo,qwen,openai
JENEFAR_PROVIDER_COOLDOWN_SECONDS=60
# Keep providers with exhausted credits/quota out of rotation for an hour by default.
JENEFAR_PROVIDER_QUOTA_COOLDOWN_SECONDS=3600

# Bound cloud LLM retries so local inference still has time after a quota/timeout error.
# Total task budget defaults to 180 seconds. Cloud providers share a 20-second window;
# at least 45 seconds remain reserved for the local Ollama fallback.
JENEFAR_AGENT_TIMEOUT_SECONDS=180
JENEFAR_ONLINE_LLM_BUDGET_SECONDS=20
JENEFAR_LOCAL_FALLBACK_RESERVE_SECONDS=45


# APInex (OpenAI-compatible API; use a free/ model ID to select free-category models)
# Base URL: https://api.apinex.bond/v1
APINEX_API_KEY=
APINEX_MODEL=free/gpt-6-luna

# UnoRouter (OpenAI-compatible gateway; confirm model ID with GET /v1/models)
UNOROUTER_API_KEY=
UNOROUTER_MODEL=ling-3.0-flash-vl:free

# APMix (OpenAI-compatible gateway)
APMIX_API_KEY=
APMIX_MODEL=qwen3.8-max

# NVIDIA Build / NIM (OpenAI-compatible Chat Completions)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-70b-instruct

# Kilo AI Gateway (OpenAI-compatible; model IDs are key/catalog dependent)
KILO_API_KEY=
KILO_MODEL=anthropic/claude-sonnet-4.5

# Qwen Cloud / Alibaba Model Studio (regional endpoint + key must match)
DASHSCOPE_API_KEY=
QWEN_MODEL=qwen3.8-max
# Optional regional/workspace endpoint override, e.g. DASHSCOPE_BASE_URL=https://<workspace>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq (OpenAI-compatible endpoint)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=hi
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy

# Cerebras (OpenAI-compatible endpoint)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# Voice models
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Browser microphone speech-to-text failover. Providers are tried left-to-right.
# Gemini is first for setups that already use the Telegram agent's Google API key.
JENEFAR_VOICE_PROVIDER_ORDER=gemini,groq,openai
JENEFAR_GEMINI_STT_MODEL=gemini-3.8-flash
JENEFAR_GEMINI_STT_TIMEOUT=35
# Offline-first fallback STT. Run `python run.py --setup-voice` once while online to install faster-whisper and cache a multilingual base model.
# Runtime transcription reads only local cache and can fall back from an uncached `small` alias to cached `base`/`tiny` models.
JENEFAR_LOCAL_STT_MODEL=base
JENEFAR_LOCAL_STT_MODEL_PATH=
JENEFAR_LOCAL_STT_DEVICE=cpu
JENEFAR_LOCAL_STT_COMPUTE_TYPE=int8
JENEFAR_LOCAL_STT_LANGUAGE=auto
# Quota exhaustion is kept out of the voice rotation for 1 hour by default.
JENEFAR_VOICE_QUOTA_COOLDOWN_SECONDS=3600
# Set this to true only when your Groq organization has not accepted
# the Orpheus TTS model terms. STT will continue to use Groq normally.
JENEFAR_DISABLE_GROQ_TTS=false

JENEFAR_LOG_LEVEL=INFO
JENEFAR_REQUIRE_CONFIRMATION=false
JENEFAR_AUTHORIZED_TARGETS=

# Continuous voice / legacy phrase-listener tuning
JENEFAR_VOICE_SAMPLE_RATE=24000
JENEFAR_VOICE_BLOCK_MS=100
JENEFAR_VOICE_START_THRESHOLD=0.015
JENEFAR_VOICE_STOP_THRESHOLD=0.010
JENEFAR_VOICE_SILENCE_MS=850
JENEFAR_VOICE_MAX_UTTERANCE_SECONDS=12


# Local wake word (optional): path to a custom openWakeWord model
JENEFAR_WAKEWORD_MODEL_PATH=
JENEFAR_WAKEWORD_THRESHOLD=0.55

# VRM avatar: optional licensed local model served by the avatar server.
# When empty, the documented sample is provisioned automatically.
JENEFAR_AVATAR_VRM_PATH=
JENEFAR_PREMIUM_AVATAR=1
JENEFAR_BLENDER_BIN=
JENEFAR_BLENDER_TIMEOUT=180

# Browser Realtime voice
# Optional LIVE VOICE: low-latency speech-to-speech; requires active OpenAI API access and credits.
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=coral

# Natural browser TTS for normal Jenefar responses.
# Audio is generated by the server and played in the browser; no Python speaker playback is used.
JENEFAR_BROWSER_TTS_MODEL=gpt-4o-mini-tts
JENEFAR_BROWSER_TTS_VOICE=coral
JENEFAR_BROWSER_TTS_SPEED=0.98
JENEFAR_BROWSER_TTS_INSTRUCTIONS=Speak as a warm, natural, emotionally expressive adult female voice. Use a relaxed Indian conversational style for Roman Hinglish. Sound like a real person, not a narrator or robot. Use gentle pauses and natural emphasis.
# When OpenAI TTS is out of quota, try expressive Gemini 3.8 Flash TTS before Edge TTS.
# Requires a valid Gemini API key (GEMINI_API_KEY or Google LLM_API_KEY) and TTS model access.
JENEFAR_GEMINI_TTS_MODEL=gemini-3.8-flash-tts
JENEFAR_GEMINI_TTS_VOICE=Aoede
# Optional global override; blank lets Jenefar choose style by response intent.
JENEFAR_GEMINI_TTS_STYLE=
JENEFAR_EDGE_TTS_RATE=-2%
JENEFAR_EDGE_TTS_PITCH=+2Hz

# Optional REA (Reverse Engineer Anything) MCP bridge.
# Uses the official documented rea-agents stdio server command through Node.js/npx.
# Empty command means "npx"; use an absolute npx path if the GUI PATH differs.
JENEFAR_REA_ENABLED=true
JENEFAR_REA_COMMAND=npx
JENEFAR_REA_ARGS=-y,rea-agents@6.5.0,mcp
JENEFAR_REA_TIMEOUT_SECONDS=120
JENEFAR_REA_MAX_RESULT_CHARS=20000
JENEFAR_REA_SKILL_ENABLED=true

# Robotics (optional)
JENEFAR_ROBOT_SERIAL_PORT=
JENEFAR_ROBOT_BAUDRATE=115200
JENEFAR_MQTT_HOST=
JENEFAR_MQTT_PORT=1883
JENEFAR_MQTT_COMMAND_TOPIC=jenefar/robot/command
JENEFAR_MQTT_TELEMETRY_TOPIC=jenefar/robot/telemetry

# Offline/local LLM fallback (Ollama native API or OpenAI-compatible local server).
# "auto" discovers Ollama /api/tags first on port 11434, otherwise uses /v1/models.
JENEFAR_LOCAL_LLM_API=auto
JENEFAR_LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
# Leave blank to auto-select the smallest installed chat model; explicitly pin only models that fit this machine, e.g. qwen3:8b.
JENEFAR_LOCAL_LLM_MODEL=
# Interactive CPU/RAM guard: prefer installed models <= 8B unless larger models are explicitly enabled.
JENEFAR_LOCAL_LLM_MAX_PARAMS_BILLIONS=8
JENEFAR_LOCAL_LLM_ALLOW_LARGE_MODEL=false
# Direct-answer defaults avoid long Qwen thinking stalls; set THINK=true to opt back in.
# Total socket timeout ceiling; primary/retry attempts below are shorter and bounded.
JENEFAR_LOCAL_LLM_TIMEOUT_SECONDS=600
JENEFAR_LOCAL_LLM_PRIMARY_TIMEOUT_SECONDS=45
JENEFAR_LOCAL_LLM_RETRY_TIMEOUT_SECONDS=120
# After both attempts time out, Jenefar tries this model only if it is already installed.
# Leave blank to automatically choose the smallest installed non-vision model.
JENEFAR_LOCAL_LLM_FALLBACK_MODEL=
JENEFAR_LOCAL_LLM_THINK=false
JENEFAR_LOCAL_LLM_KEEP_ALIVE=30s
JENEFAR_LOCAL_LLM_NUM_CTX=2048
JENEFAR_LOCAL_LLM_NUM_PREDICT=192
# auto advertises only relevant tools to the local model; use all for legacy behavior.
JENEFAR_LOCAL_LLM_TOOL_MODE=auto

# Dedicated Kali security specialist model (optional; falls back to OPENAI_MODEL/local model)
JENEFAR_KALI_MODEL=

# Authorized local workspace roots (pathsep-separated; current project + /home/jenefar/Document/Tools are built in)
JENEFAR_WORKSPACE_ROOTS=


# Phase 1 model routing. Unset profiles fall back to OPENAI_MODEL online and JENEFAR_LOCAL_LLM_MODEL offline.
JENEFAR_MODEL_FAST=
JENEFAR_MODEL_REASONING=
JENEFAR_MODEL_CODING=
JENEFAR_MODEL_SECURITY=
JENEFAR_MODEL_RESEARCH=
JENEFAR_MODEL_ROBOTICS=
JENEFAR_MODEL_AUTOMATION=

# Optional per-role local model overrides.
JENEFAR_LOCAL_LLM_MODEL_FAST=
JENEFAR_LOCAL_LLM_MODEL_CODING=
JENEFAR_LOCAL_LLM_MODEL_SECURITY=
JENEFAR_LOCAL_LLM_MODEL_RESEARCH=
JENEFAR_LOCAL_LLM_MODEL_ROBOTICS=
JENEFAR_LOCAL_LLM_MODEL_AUTOMATION=
JENEFAR_LOCAL_LLM_MODEL_VISION=

# Phase 2 semantic GUI / vision
JENEFAR_MODEL_VISION=
JENEFAR_VISION_MODEL=
JENEFAR_VISION_CONFIDENCE=0.65
JENEFAR_VISION_MAX_DIMENSION=1600
JENEFAR_LOCAL_VISION_MODEL=qwen3-vl:4b
JENEFAR_LOCAL_VISION_BASE_URL=http://127.0.0.1:11434
JENEFAR_VISION_LOCAL_FIRST=true
JENEFAR_VISION_ALLOW_ONLINE=false
# Screen/window control stays local; normal knowledge/coding tasks may use configured online providers.

# Phase 3 declarative skill manifests. Multiple roots use the OS path separator.
JENEFAR_SKILL_ROOTS=

# Safe desktop validation. Use "headless" on servers/CI without a display.
# Native mode uses pyautogui and requires a real desktop session.
JENEFAR_DESKTOP_BACKEND=native

# Phase 4 persistent memory + scheduler data remain in the local data/ directory.
# Layered memory uses SQLite/FTS5 and optional sentence-transformers embeddings.
# Scheduler supports once, interval, daily and explicit event-watch triggers.

# Optional legacy/native Python TTS. Browser runtime does not use native TTS
# unless you explicitly enable it for a legacy CLI voice mode.
JENEFAR_ENABLE_NATIVE_TTS=0

# Optional local offline TTS. Browser speech fallback tries this configured Piper
# ONNX voice model after cloud TTS providers fail, before Edge/network speech.
# Use an absolute path to the licensed model file (.onnx); Piper must be on PATH.
JENEFAR_LOCAL_TTS_MODEL=
JENEFAR_LOCAL_TTS_TIMEOUT_SECONDS=35

# Legacy voice path: calibrated phrase capture + Google STT (fallback to VAD/online STT).
JENEFAR_LEGACY_AMBIENT_SECONDS=0.7
JENEFAR_LEGACY_LISTEN_TIMEOUT=5
JENEFAR_LEGACY_PHRASE_LIMIT=10
JENEFAR_LEGACY_PAUSE_THRESHOLD=0.8
JENEFAR_LEGACY_STT_LANGUAGE=hi-IN
JENEFAR_EDGE_TTS_VOICE=en-IN-NeerjaNeural
JENEFAR_ESPEAK_RATE=165

# Primary one-command voice input: browser microphone (Chrome/Chromium Web Speech API).
# Browser playback prefers generated server audio and falls back to Edge TTS, then Web SpeechSynthesis.
JENEFAR_BROWSER_VOICE=1


# ---------------------------------------------------------------------------
# Telegram-only autonomous agent (entrypoint: python main.py)
# Create a bot with BotFather; keep this token private.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID(s), comma-separated. Replace the sample value.
ALLOWED_TELEGRAM_USER_IDS=123456789

# OpenAI-compatible chat completions API. Generic names are preferred.
# Default sample uses Google's Gemini OpenAI-compatible API; free-tier limits apply.
# Get a Gemini API key from https://aistudio.google.com/apikey.
# LLM_API_KEY may be left blank to fall back to GEMINI_API_KEY above.
# To use Groq/OpenRouter instead, configure this key, base URL and model together.
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL_NAME=gemini-3.8-flash

# Fine-grained GitHub PAT: grant only the repositories and permissions you need.
# GitHub tools report a configuration error until a PAT is provided.
GITHUB_PAT=
GITHUB_API_URL=https://api.github.com

# Persistent Telegram-agent scratchpad path (mounted as a Docker volume in Compose).
SCRATCHPAD_DIR=data/scratchpad
SKILL_STORE_DIR=data/skills
REQUEST_TIMEOUT_SECONDS=30
AGENT_TIMEOUT_SECONDS=180
MAX_TOOL_ROUNDS=8
MAX_HISTORY_MESSAGES=24
MAX_INPUT_CHARS=12000
MAX_TOOL_OUTPUT_CHARS=12000
LOG_LEVEL=INFO

# Optional custom OpenAI-compatible endpoint overrides (provider-specific):
# JENEFAR_APINEX_BASE_URL=, JENEFAR_UNOROUTER_BASE_URL=, JENEFAR_APMIX_BASE_URL=, JENEFAR_NVIDIA_BASE_URL=, JENEFAR_KILO_BASE_URL=
