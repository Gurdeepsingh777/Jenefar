JENEFAR_NAME=Jenefar
JENEFAR_WAKE_PHRASES=Hi Jenefar,Hello Jenefar

# Required for model-backed responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Voice models
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

JENEFAR_LOG_LEVEL=INFO
JENEFAR_REQUIRE_CONFIRMATION=true
JENEFAR_AUTHORIZED_TARGETS=

# Continuous voice/VAD tuning
JENEFAR_VOICE_SAMPLE_RATE=24000
JENEFAR_VOICE_BLOCK_MS=100
JENEFAR_VOICE_START_THRESHOLD=0.015
JENEFAR_VOICE_STOP_THRESHOLD=0.010
JENEFAR_VOICE_SILENCE_MS=850
JENEFAR_VOICE_MAX_UTTERANCE_SECONDS=12
